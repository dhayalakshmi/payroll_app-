pipeline {
    agent any
    stages {
        stage('Checkout') {
            steps {
                git branch: 'authentication', url: 'https://github.com/dhayalakshmi/payroll_app-.git'
            }
        }
        stage('Build') {
            steps {
                bat 'python -m pip install -r requirements.txt'
            }
        }
        stage('Docker Build') {
            steps {
                bat 'docker build -t payroll-flask:setF .'
            }
        }
        
    
    }
}
